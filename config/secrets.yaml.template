# secrets.yaml - Copy this to secrets.yaml and insert your credentials.
# Do NOT commit secrets.yaml to version control!

# Gemini API Key (Required for Gemini-powered trail analysis)
GEMINI_API_KEY: "your_google_studio_gemini_api_key_here"

# SMTP Settings (Required for sending emails, optional for --dry-run)
SMTP_SERVER: "smtp.gmail.com"
SMTP_PORT: 587
SMTP_USER: "your_sender_email@gmail.com"
SMTP_PASSWORD: "your_sender_app_specific_password_here"
RECIPIENT_EMAILS: "recipient1@example.com,recipient2@example.com"
